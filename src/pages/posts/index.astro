---
import BaseLayout from '../../src/layouts/BaseLayout.astro';
const posts = [
  { title: '端庄的设计', description: '如何用简洁、极简和稳定的视觉语言表达专业与克制。', href: '/posts/post-1/' },
  { title: '现代动效', description: '轻量而顺滑的动画如何提升页面质感与阅读体验。', href: '/posts/post-2/' }
];
---

<BaseLayout title="文章列表" description="精选文章">
  <section class="content-shell py-20">
    <div class="mb-10">
      <p class="text-sm uppercase tracking-[0.3em] text-slate-500">Blog</p>
      <h1 class="mt-4 text-4xl md:text-5xl font-semibold text-slate-900">文章列表</h1>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {posts.map((post) => (
        <a href={post.href} class="card-hover block rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-3 inline-flex rounded-full bg-slate-100 px-2 py-1 text-xs font-medium text-slate-600">Article</div>
          <h2 class="text-2xl font-semibold text-slate-900">{post.title}</h2>
          <p class="mt-3 text-slate-600 leading-7">{post.description}</p>
          <span class="mt-5 inline-flex items-center text-sm font-medium text-slate-800">阅读文章 →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
