---
import Header from '../components/Header.astro';
const nav = [
  { href: '/', label: '首页' },
  { href: '/posts/', label: '文章' },
  { href: '#about', label: '关于' }
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur-md">
  <div class="content-shell flex items-center justify-between py-4">
    <a href="/" class="flex items-center gap-3">
      <img src="/favicon.svg" alt="站点 logo" class="h-10 w-10 rounded-xl shadow-sm" />
      <div>
        <div class="text-lg font-semibold text-slate-900">个人博客</div>
        <div class="-mt-1 text-[11px] uppercase tracking-[0.24em] text-slate-500">Journal</div>
      </div>
    </a>

    <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex">
      {nav.map((item) => (
        <a href={item.href} class="transition hover:text-slate-900">{item.label}</a>
      ))}
    </nav>

    <button class="rounded-xl border border-slate-200 p-2 md:hidden" aria-label="菜单按钮">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>
